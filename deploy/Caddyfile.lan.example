# Caddyfile for a LAN deployment of Taco Analyzer, using Caddy's own internal CA.
# taco-analyzer-managed: this marker tells deploy/uninstall.sh the file is ours.
#
# deploy/install.sh copies this file to /etc/caddy/Caddyfile and substitutes:
#   __HOSTNAME__  the name you passed to --hostname (for example taco.lan)
#   __PORT__      the app's local port (default 8787)
# If you edit /etc/caddy/Caddyfile by hand, replace those tokens yourself.
#
# WHEN YOU NEED "tls internal"
#   Caddy already uses its internal CA automatically for "localhost", for bare
#   IP addresses, and for names ending in .local, .internal and .home.arpa.
#   For any other private name (taco.lan, taco.corp, and so on) it would try
#   Let's Encrypt and fail, so "tls internal" below is what forces the local CA.
#   Leaving it in place is harmless even for the automatic cases.
#
# CLIENTS WILL SHOW A CERTIFICATE WARNING UNTIL YOU INSTALL THE ROOT CA.
#   Root CA certificate:
#     /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt
#   See DEPLOY.md, "Install the LAN root CA", for per-device instructions.

{
	# The caddy service user cannot write the system trust store, and inside a
	# container it should not try. Without this, Caddy logs a scary but harmless
	# "failed to install root certificate" error on every start.
	skip_install_trust

	pki {
		ca local {
			# Cosmetic: this is the name devices will show in their trust store
			# once you install the root certificate. Changing it later means
			# regenerating the CA, which means reinstalling it on every device.
			name "Taco Analyzer Local CA"
		}
	}

	# Do not advertise the server version in responses.
	servers {
		protocols h1 h2 h3
	}
}

__HOSTNAME__ {
	tls internal

	encode zstd gzip

	# Cap the request body at the proxy as well as in the app. The app's own
	# MAX_UPLOAD_BYTES is 10 MiB by default; this is deliberately a little
	# higher so that multipart framing overhead does not cause Caddy to reject
	# an upload that the app would have accepted with a friendly error.
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:__PORT__ {
		# X-Forwarded-For, -Proto and -Host are deliberately NOT restated here.
		# reverse_proxy sets them itself, and Caddy logs a warning if you repeat
		# them.
		#
		# On forwarded addresses: Caddy APPENDS the real peer to any incoming
		# X-Forwarded-For rather than replacing it, so a client that sends
		# "X-Forwarded-For: 1.2.3.4" produces "1.2.3.4, <real ip>". That is safe
		# here because the app reads the RIGHTMOST entry, which is the one Caddy
		# appended and the only one it can vouch for. A forged prefix is ignored.
		# If you ever put another proxy in front of Caddy, revisit that
		# assumption in server/auth/middleware.js (clientIp).

		# Fail fast rather than hanging if the app is restarting.
		transport http {
			dial_timeout 5s
		}
	}

	log {
		output file /var/log/caddy/taco-analyzer.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
