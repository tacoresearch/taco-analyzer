# Taco Analyzer systemd unit TEMPLATE.
#
# deploy/install.sh renders this file to /etc/systemd/system/taco-analyzer.service,
# replacing __APP_DIR__ with the directory the repository was cloned into
# (canonically /opt/taco-analyzer). If you install it by hand, replace that token
# yourself; systemd will not do it for you.
#
# ============================================================================
#  READ THIS BEFORE ADDING MORE HARDENING
# ============================================================================
#
#  1. DO NOT ADD "MemoryDenyWriteExecute=yes". IT BREAKS NODE.JS, HARD.
#     V8's JIT (TurboFan) and the irregexp regular-expression engine allocate
#     memory, write machine code into it, and then mprotect() it executable.
#     MemoryDenyWriteExecute blocks exactly that write-then-execute transition,
#     so Node dies with an immediate SIGTRAP. Combined with Restart=on-failure
#     below, the result is a silent restart loop that looks like an application
#     bug rather than a unit-file mistake. There is no Node.js flag that makes
#     this safe. Leave it out.
#
#  2. DO NOT ADD "SystemCallFilter=~@resources". Node and libuv call setrlimit()
#     during startup, which lives in @resources. Subtracting that set kills the
#     process at boot. Plain SystemCallFilter=@system-service (below) already
#     covers the useful ground.
#
#  3. RestrictAddressFamilies MUST keep AF_UNIX and AF_NETLINK. AF_NETLINK is
#     used by os.networkInterfaces() and, more importantly, by glibc's
#     getaddrinfo(), so removing it breaks all DNS resolution. AF_UNIX is used
#     by libuv internals.
#
#  4. NoNewPrivileges=yes makes file capabilities inert, so running setcap on
#     the node binary silently stops having any effect. That does not matter
#     here because this service binds 127.0.0.1:8787 (an unprivileged port) and
#     Caddy owns 80/443. If you ever want Node itself on port 443, use a socket
#     unit or AmbientCapabilities, not setcap.
#
#  5. PrivateDevices=yes and PrivateUsers=yes are deliberately absent.
#     PrivateDevices is a known breaker inside LXC containers (bind-mount
#     conflict on /dev/ptmx). PrivateUsers/DynamicUser would give the service an
#     unstable UID, which is the last thing you want on a SQLite file you intend
#     to back up and restore.
#
#  6. Inside an unprivileged LXC container, the mount-namespace directives
#     (ProtectSystem, ProtectHome, ProtectProc, PrivateTmp, ProtectControlGroups,
#     ProtectKernel*) can fail with "Failed at step NAMESPACE". install.sh
#     detects that and drops a relaxing override in
#     /etc/systemd/system/taco-analyzer.service.d/. The seccomp and capability
#     directives do not need mount namespacing and are never relaxed.
# ============================================================================

[Unit]
Description=Taco Analyzer (survey collection app)
Documentation=file://__APP_DIR__/DEPLOY.md
After=network-online.target
Wants=network-online.target
# Five failed starts in a minute stops the loop instead of hammering the box.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=tacoapp
Group=tacoapp
WorkingDirectory=__APP_DIR__

# Generated by install.sh, mode 0640, owned root:tacoapp. Read by PID 1 before
# the sandbox is set up, so ProtectSystem=strict below does not interfere.
EnvironmentFile=/etc/taco-analyzer/taco-analyzer.env

# Node and npm write dotfiles into $HOME. A nologin system user's home is
# /nonexistent, which makes npm fail with EACCES/ENOENT in ways that are
# genuinely hard to diagnose. Point HOME at the state directory instead.
# Deliberately set here and NOT in the environment file, so it cannot be
# clobbered by an operator editing that file.
Environment=HOME=/var/lib/taco-analyzer

ExecStart=/usr/local/bin/node __APP_DIR__/server/index.js

# Database migrations are NOT run here on purpose. Two units racing to migrate
# during a restart storm is worse than a stale schema. install.sh and update.sh
# run "npm run migrate" with the service stopped.

Restart=on-failure
RestartSec=2s
TimeoutStartSec=60
TimeoutStopSec=20
KillSignal=SIGTERM
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=taco-analyzer

# --- State directory -------------------------------------------------------
# Creates /var/lib/taco-analyzer, chowns it to tacoapp:tacoapp, and adds it to
# the sandbox's read-write set automatically. Also survives ProtectSystem=strict.
StateDirectory=taco-analyzer
StateDirectoryMode=0750

# --- Hardening: privileges and syscalls ------------------------------------
# None of these need mount namespacing, so they work in every container and
# must never be relaxed.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
LimitNOFILE=65535

# --- Hardening: filesystem and kernel -------------------------------------
# These DO need mount namespacing and are what install.sh relaxes if the
# container refuses them.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/taco-analyzer
ProtectProc=invisible
ProcSubset=pid
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target
